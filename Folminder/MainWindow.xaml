<Window x:Class="Folminder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Folminder"
        xmlns:vm="clr-namespace:Folminder.ViewModels"
        xmlns:controls="clr-namespace:Folminder.Controls"
        xmlns:helpers="clr-namespace:Folminder.Helpers"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="MainWindow" Height="200" Width="168"
        MinWidth="400"
        MinHeight="200"
        WindowStartupLocation="CenterScreen"
        Visibility="Hidden"
        d:Visibility="Visible"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- ViewModelへのバインディング用プロキシ -->
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}"/>

        <!-- NotifyIconのコンテキストメニュー -->
        <ContextMenu x:Key="NotifyIconContextMenu">
            <MenuItem Header="開く" Command="{Binding Data.OpenWindowCommand, Source={StaticResource ViewModelProxy}}"/>
            <MenuItem Header="設定..." Command="{Binding Data.ShowSettingsCommand, Source={StaticResource ViewModelProxy}}"/>
            <Separator/>
            <MenuItem Header="終了" Command="{Binding Data.ExitCommand, Source={StaticResource ViewModelProxy}}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- NotifyIcon -->
        <tb:TaskbarIcon x:Name="NotifyIcon"
                        ToolTipText="Folminder"
                        ContextMenu="{StaticResource NotifyIconContextMenu}"
                        TrayMouseDoubleClick="NotifyIcon_TrayMouseDoubleClick"
                        d:IsHidden="True"/>

        <controls:FolderListView
            x:Name="MainListView"
            RowItemsSource="{Binding Items}"
            SelectedRowItem="{Binding SelectedItem, Mode=TwoWay}"
            CheckBoxColumnWidth="28"
            KeyColumnWidth="28"
            PreferredSizeChanged="OnFolderListViewPreferredSizeChanged"
            VirtualizingPanel.IsVirtualizing="False"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <!-- BindingProxy：GridViewColumn に ActualWidth 系プロパティを渡すための中継 -->
            <controls:FolderListView.Resources>
                <helpers:BindingProxy x:Key="proxy"
                            Data="{Binding ElementName=MainListView}"/>
            </controls:FolderListView.Resources>

            <controls:FolderListView.View>
                <GridView>

                    <!-- Column 1: ピン留め (CheckBox) -->
                    <GridViewColumn
                                Width="{Binding Data.CheckBoxColumnWidth,
                                Source={StaticResource proxy}}">
                        <GridViewColumn.Header>
                            <TextBlock Text="📌" ToolTip="ピン留め"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Pinned, Mode=TwoWay}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Column 2: ショートカットキー -->
                    <GridViewColumn
                                Width="{Binding Data.KeyColumnWidth,
                                Source={StaticResource proxy}}">
                        <GridViewColumn.Header>
                            <TextBlock Text="Key"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Key}"
                                   HorizontalAlignment="Center"
                                   FontFamily="Consolas"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Column 3: フォルダー名（残幅すべて） -->
                    <GridViewColumn
                                x:Name="folderColumn"
                                Width="{Binding Data.FolderNameColumnWidth,
                                Source={StaticResource proxy}}">
                        <GridViewColumn.Header>
                            <TextBlock Text="フォルダー"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TruncatedName}"
                                   TextTrimming="None"
                                   ToolTip="{Binding Source.Path}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </controls:FolderListView.View>

        </controls:FolderListView>

        <!-- 下端に横に3つボタンを配置 -->
        <Grid Grid.Row="1">
            <Button x:Name="OpenExplorerButton" Content="エクスプローラーを開く" HorizontalAlignment="Left" Margin="10" Padding="10" Command="{Binding OpenExplorerCommand}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button x:Name="AcceptButton" Content="OK" Margin="3,0,3,0" Padding="20,10,20,10" IsDefault="True" Command="{Binding AcceptCommand}"/>
                <Button x:Name="ApplyButton" Content="適用" Margin="3,0,3,0" Padding="20,10,20,10" Command="{Binding ApplyCommand}"/>
                <Button x:Name="CancelButton" Content="キャンセル" Margin="3,0,0,0" Padding="10" IsCancel="True" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
