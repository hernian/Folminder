<UserControl x:Class="Folminder.Controls.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Folminder.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="400"
             x:Name="ToastRoot">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Error Toast の設定 -->
            <ResourceDictionary x:Key="ErrorToastSettings">
                <SolidColorBrush x:Key="Background" Color="#F44336"/>
                <SolidColorBrush x:Key="Foreground" Color="White"/>
                <sys:Int32 x:Key="Duration">5000</sys:Int32>
            </ResourceDictionary>

            <!-- Information Toast の設定 -->
            <ResourceDictionary x:Key="InformationToastSettings">
                <SolidColorBrush x:Key="Background" Color="#2196F3"/>
                <SolidColorBrush x:Key="Foreground" Color="White"/>
                <sys:Int32 x:Key="Duration">3000</sys:Int32>
            </ResourceDictionary>

            <!-- アニメーション -->
            <Storyboard x:Key="FadeInStoryboard">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                               From="0" To="1" Duration="0:0:0.3"/>
            </Storyboard>
            <Storyboard x:Key="FadeOutStoryboard">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                               From="1" To="0" Duration="0:0:0.3"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="ToastBorder"
            Background="{Binding ToastBackground, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=#F44336}"
            CornerRadius="4"
            Padding="16,12"
            Margin="10"
            MaxWidth="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Opacity="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" 
                            BlurRadius="10" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="MessageText"
                      Grid.Column="0"
                      Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Foreground="{Binding ToastForeground, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=White}"
                      TextWrapping="Wrap"
                      MaxWidth="450"
                      VerticalAlignment="Center"
                      FontSize="14"/>

            <Button Grid.Column="1"
                   Content="✕"
                   Margin="12,0,0,0"
                   Padding="8,4"
                   Background="Transparent"
                   Foreground="{Binding ToastForeground, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=White}"
                   BorderThickness="0"
                   FontSize="16"
                   FontWeight="Bold"
                   Cursor="Hand"
                   Click="CloseButton_Click"
                   VerticalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                           Padding="{TemplateBinding Padding}"
                                           CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
