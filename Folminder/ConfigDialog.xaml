<Window x:Class="Folminder.ConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Folminder"
        mc:Ignorable="d"
        Title="Folminderの設定" Height="385" Width="322"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False" Icon="pack://application:,,,/Resources/folminder.ico">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 第1カラム: TextBlock + CheckBox×4 -->
        <TextBlock Grid.Column="0" Grid.Row="0" Text="修飾キー" FontWeight="Bold" Margin="0,0,0,0"/>
        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,10,10,0">
            <CheckBox Content="Alt" IsChecked="{Binding Alt}" Margin="0,0,0,5"/>
            <CheckBox Content="Control" IsChecked="{Binding Control}" Margin="0,0,0,5"/>
            <CheckBox Content="Shift" IsChecked="{Binding Shift}" Margin="0,0,0,5"/>
            <CheckBox Content="Win" IsChecked="{Binding Win}"/>
        </StackPanel>

        <!-- 第2カラム: TextBlock + ListBox -->
        <TextBlock Grid.Column="1" Grid.Row="0" Text="キー" FontWeight="Bold" Margin="0,0,0,0" VerticalAlignment="Top"/>
        <ListBox x:Name="KeyListBox"
                 Grid.Column="1" Grid.Row="1"
                 ItemsSource="{Binding Items}" 
                 SelectedItem="{Binding SelectedItem}"
                 DisplayMemberPath="Name"
                 Margin="0,10,10,0"/>

        <!-- 第3カラム: Button×2 -->
        <StackPanel Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,0,0,10">
            <Button Content="OK" Width="80" Height="30" 
                    Margin="0,5,0,5" IsDefault="True" 
                    Command="{Binding AcceptCommand}"/>
            <Button Content="キャンセル" Width="80" Height="30" 
                    Margin="0,5,0,5" IsCancel="True" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
