<Window x:Class="Folminder.ConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Folminder"
        mc:Ignorable="d"
        Title="設定" Height="368" Width="322"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 第1カラム: TextBlock + CheckBox×4 -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="修飾キー" FontWeight="Bold" Margin="0,0,0,10"/>
            <CheckBox Content="Alt" IsChecked="{Binding Alt}" Margin="0,0,0,5"/>
            <CheckBox Content="Control" IsChecked="{Binding Control}" Margin="0,0,0,5"/>
            <CheckBox Content="Shift" IsChecked="{Binding Shift}" Margin="0,0,0,5"/>
            <CheckBox Content="Win" IsChecked="{Binding Win}"/>
        </StackPanel>

        <!-- 第2カラム: TextBlock + ListBox -->
        <StackPanel Grid.Column="1" Margin="0,0,10,0">
            <TextBlock Text="キー" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListBox ItemsSource="{Binding Items}" 
                     SelectedItem="{Binding SelectedItem}"
                     DisplayMemberPath="Name"
                     Height="300"/>
        </StackPanel>

        <!-- 第3カラム: Button×2 -->
        <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <Button Content="OK" Width="80" Height="30" 
                    Margin="0,50,0,10" IsDefault="True" 
                    IsEnabled="{Binding IsOkButtonEnabled}"
                    Click="OkButton_Click"/>
            <Button Content="キャンセル" Width="80" Height="30" 
                    IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
